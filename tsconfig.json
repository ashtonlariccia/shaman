{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // vite/client supplies the ambient declarations for side-effect asset
    // imports (e.g. `import "./app.css"`).
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.svelte", "vite.config.ts"]
}
